# ==============================================================================
# MED SHOP - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Site & Contact Settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=212600000000

# 2. Admin Dashboard Security Passcode
ADMIN_PASSCODE=medshop2026

# 3. Supabase PostgreSQL Database Credentials (Order Management)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 4. Sanity.io Credentials (Content Management CMS)
# Obtain these from: sanity.io/manage -> Project Settings
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
